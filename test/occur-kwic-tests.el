          (should-not (marker-buffer (cdr pair)))))
      (should-not (marker-buffer (car region)))
      (should-not (marker-buffer (cdr region)))
      (should-not (marker-buffer arrow))
      (dolist (overlay overlays) (should-not (overlay-buffer overlay)))
      (should (eq (marker-buffer foreign) source))
      (occur-kwic--cleanup)
      (should (eq (marker-buffer foreign) source))
