(ert-deftest occur-kwic-test-standard-clones-have-independent-lifetimes ()
  (dolist (route '(key extended named))
    (dolist (close-first '(clone original))
      (occur-kwic-test--with-results ("one X two X\n" "X" nil (cons 1 13))
        (let* ((original-entry (car occur-kwic--entries))
               (original-target (caar (occur-kwic--entry-targets original-entry)))
               (text (buffer-string))
               (clone (pcase route
                        ('key (let ((current-prefix-arg nil))
                                (call-interactively (key-binding "c"))))
                        ('extended (execute-extended-command nil "clone-buffer")
                                   (current-buffer))
                        ('named (clone-buffer " *kwic-named-clone*" nil))))
               (clone-entry (with-current-buffer clone (car occur-kwic--entries)))
               (clone-target (caar (occur-kwic--entry-targets clone-entry)))
               (survivor (if (eq close-first 'clone) result clone))
               (survivor-target (if (eq close-first 'clone) original-target clone-target)))
          (when (eq route 'named)
            (should (eq (current-buffer) result))
            (should (equal (buffer-name clone) " *kwic-named-clone*")))
          (should-not (eq original-entry clone-entry))
          (should-not (eq original-target clone-target))
          (with-current-buffer clone
            (should-not (eq (car occur-kwic--region)
                            (car (buffer-local-value 'occur-kwic--region result))))
            (should (equal text (buffer-string)))
            (should (eq (get-text-property (occur-kwic--entry-row-begin clone-entry)
                                           'occur-kwic-entry)
                        clone-entry))
            (let ((targets (get-text-property (occur-kwic--entry-row-begin clone-entry)
                                               'occur-target)))
              (should (eq (if (markerp targets) targets (caar targets)) clone-target)))
            (occur-kwic-set-alignment 'right))
          (with-current-buffer result
            (should (eq occur-kwic-alignment 'left))
            (dolist (view occur-kwic--views)
              (dolist (overlay (occur-kwic--view-overlays view))
                (should (eq (overlay-buffer overlay) result)))))
          (kill-buffer (if (eq close-first 'clone) clone result))
          (should (eq (marker-buffer survivor-target) source))
          (with-current-buffer survivor
            (should (eq (marker-buffer (car occur-kwic--region)) source))
            (revert-buffer nil t)
            (should (= (length occur-kwic--entries) 2))
            (goto-char (occur-kwic--entry-row-begin (car occur-kwic--entries)))
            (occur-mode-goto-occurrence)
            (should (eq (current-buffer) source))
            (should (= (point) 5))))))))

(ert-deftest occur-kwic-test-clone-preserves-point-restriction-and-expansion ()
  (occur-kwic-test--with-results
      ((concat (make-string 100 ?a) "XXX tail\nother XXX suffix\n") "XXX")
    (let* ((entry (car occur-kwic--entries))
           (begin (occur-kwic--entry-row-begin entry))
           (end (1+ (occur-kwic--entry-row-end entry)))
           (position (+ (occur-kwic--entry-text-begin entry)
                        (occur-kwic--entry-end entry))))
      (occur-kwic-set-alignment 'right)
      (goto-char position)
      (occur-kwic-toggle-line)
      (occur--set-arrow)
      (narrow-to-region begin end)
      (set-mark begin)
      (let* ((current-prefix-arg nil)
             (clone (call-interactively (key-binding "c")))
             (clone-entry (car occur-kwic--entries)))
        (should (= (point) position))
        (should (= (mark t) begin))
        (should (= (point-min) begin))
        (should (= (point-max) end))
        (should (eq occur-kwic-alignment 'right))
        (should (eq occur-kwic--expanded clone-entry))
        (should-not (eq clone-entry entry))
        (should (markerp overlay-arrow-position))
        (should (eq (marker-buffer overlay-arrow-position) clone))
        ;; Rebind entries outside the visible restriction as well.
        (save-restriction
          (widen)
          (dolist (row occur-kwic--entries)
            (should (eq (get-text-property (occur-kwic--entry-row-begin row)
                                           'occur-kwic-entry)
                        row))))
        (kill-buffer clone)
        (with-current-buffer result
          (should (eq occur-kwic--expanded entry))
          (should (eq (marker-buffer overlay-arrow-position) result))
          (should (= (point-min) begin))
          (should (= (point-max) end)))))))

