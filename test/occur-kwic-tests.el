    (let* ((entries occur-kwic--entries)
           (entry-list (copy-sequence entries))
           (region occur-kwic--region)
           (arrow overlay-arrow-position)
           (overlays (cl-mapcan (lambda (view) (copy-sequence (occur-kwic--view-overlays view)))
                                occur-kwic--views))
           (foreign (with-current-buffer source (copy-marker 1))))
      (occur-kwic--cleanup)
      (should-not occur-kwic--entries)
      (should-not occur-kwic--views)
      (should-not occur-kwic--region)
      (should-not occur-kwic--expanded)
      (should-not overlay-arrow-position)
