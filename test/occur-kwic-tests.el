(ert-deftest occur-kwic-test-collection-abort-releases-only-new-markers ()
  (dolist (condition '(error quit))
    (occur-kwic-test--with-results ("abcXdefXghiX\n" "X")
      (let ((copy-function (symbol-function 'copy-marker))
            (search-function (symbol-function 're-search-forward))
            (old-entries occur-kwic--entries)
            (snapshot (buffer-string))
            (calls 0) markers)
        (should
         (eq condition
             (condition-case err
                 (cl-letf (((symbol-function 'copy-marker)
                            (lambda (&rest args)
                              (let ((marker (apply copy-function args)))
                                (push marker markers)
                                marker)))
                           ((symbol-function 're-search-forward)
                            (lambda (&rest args)
                              (when (= (cl-incf calls) 6) (signal condition nil))
                              (apply search-function args))))
                   (occur-kwic--run source "." nil nil 'left result))
               ((error quit) (car err)))))
        (should (= (length markers) 10))
        (dolist (marker markers) (should-not (marker-buffer marker)))
        (should (buffer-live-p result))
        (should (eq old-entries occur-kwic--entries))
        (should (equal snapshot (buffer-string)))
        (dolist (entry old-entries)
          (should (eq (marker-buffer (caar (occur-kwic--entry-targets entry))) source))))
      (with-current-buffer source
        (should (equal (buffer-string) "abcXdefXghiX\n"))
        (should-not (buffer-modified-p))))))

(ert-deftest occur-kwic-test-pending-quit-registers-marker-pair-before-cleanup ()
