(ert-deftest occur-kwic-test-bidirectional-text-retains-logical-text-and-targets ()
  ;; This checks text and navigation, not visual alignment after bidi reordering.
  (dolist (spec '(("אבג שלום דהו\nאבגדהוז שלום אב\n" "שלום")
                  ("عالم مرحبا سلام\nسلام عالم مرحبا في\n" "مرحبا")))
    (occur-kwic-test--with-results ((car spec) (cadr spec))
      (let ((snapshot (buffer-substring-no-properties (point-min) (point-max)))
            (entries occur-kwic--entries))
        (dolist (alignment '(left center right))
          (occur-kwic-set-alignment alignment)
          (should (equal snapshot (buffer-substring-no-properties (point-min) (point-max)))))
        (dolist (entry entries)
          (let* ((target (car (occur-kwic--entry-targets entry)))
                 (begin (marker-position (car target)))
                 (end (marker-position (cdr target))))
            (with-current-buffer source
              (should (equal (buffer-substring-no-properties begin end) (cadr spec)))
              (save-excursion
                (goto-char begin)
                (should (equal (occur-kwic--entry-text entry)
                               (buffer-substring-no-properties (line-beginning-position)
                                                               (line-end-position))))))
            (with-current-buffer result
              (goto-char (+ (occur-kwic--entry-text-begin entry)
                            (occur-kwic--entry-begin entry)))
              (occur-mode-goto-occurrence)
              (should (eq (current-buffer) source))
              (should (= (point) begin)))))
        (with-current-buffer source
          (should (equal (buffer-string) (car spec)))
          (should-not (buffer-modified-p)))))))

(ert-deftest occur-kwic-test-size-warning-counts-result-bytes-and-prefix-growth ()
  (dolist (text (list "界XéX\n尾X\n"
                      (concat "X\n" (make-string 8 ?\n) "X")
                      (unibyte-string 255 ?X 128 ?X ?\n ?X)))
    (let ((occur-kwic-output-size-warning-threshold nil)
          (unibyte (not (multibyte-string-p text))))
      (occur-kwic-test--with-results
          (text "X"
                (when unibyte
                  (erase-buffer)
                  (set-buffer-multibyte nil)
                  (insert text)
                  (set-buffer-modified-p nil)))
        (let* ((snapshot (buffer-string))
               (row-bytes (string-bytes
                           (buffer-substring-no-properties
                            (save-excursion (goto-char (point-min)) (forward-line 1) (point))
                            (point-max))))
               (occur-kwic-output-size-warning-threshold (1- row-bytes))
               estimates)
          (cl-letf (((symbol-function 'occur-kwic--confirm-output-size)
                     (lambda (bytes) (push bytes estimates))))
            (revert-buffer nil t))
          (should (equal estimates (list row-bytes)))
          (should (equal snapshot (buffer-string))))))))

(ert-deftest occur-kwic-test-size-warning-refusal-preserves-results-and-releases-markers ()
  (dolist (answer '(no quit))
    (occur-kwic-test--with-results ("abcXdefXghiX\n" "X")
      (let ((snapshot (buffer-string))
            (old-entries occur-kwic--entries)
            (copy-function (symbol-function 'copy-marker))
            (occur-kwic-output-size-warning-threshold 30)
            (noninteractive nil)
            (prompts 0) markers)
        (should
         (eq 'quit
             (condition-case nil
                 (cl-letf (((symbol-function 'copy-marker)
                            (lambda (&rest args)
                              (let ((marker (apply copy-function args)))
                                (push marker markers)
                                marker)))
                           ((symbol-function 'yes-or-no-p)
                            (lambda (_prompt)
                              (cl-incf prompts)
                              (when (eq answer 'quit) (signal 'quit nil))
                              nil)))
                   (occur-kwic--run source "." nil nil 'left result))
               (quit 'quit))))
        (should (= prompts 1))
        (should (= (length markers) 4))
        (dolist (marker markers) (should-not (marker-buffer marker)))
        (should (buffer-live-p result))
