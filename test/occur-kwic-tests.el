(ert-deftest occur-kwic-test-narrowing-does-not-expose-outside-context ()
  (occur-kwic-test--with-results
      ("outside X\nprefix X suffix\noutside X\n" "X"
       (progn (search-forward "prefix ")
              (let ((start (point)))
                (search-forward "X suffix")
                (narrow-to-region start (point)))))
    (should (= (length occur-kwic--entries) 1))
    (should (equal (occur-kwic--entry-text (car occur-kwic--entries)) "X suffix"))
    (should-not (string-match-p "outside\\|prefix" (buffer-string)))
    (with-current-buffer source (should (buffer-narrowed-p)))))

(ert-deftest occur-kwic-test-disjoint-region-and-narrowing-find-nothing ()
  ;; Exercise either ordering of disjoint bounds, plus touching bounds.
  ;; The gap between the two regions contains a match of its own.
  (dolist (bounds '(((1 . 8) (15 . 22))
                    ((15 . 22) (1 . 8))
                    ((1 . 8) (8 . 15))))
    (let ((region (car bounds)) (restriction (cadr bounds)))
      (occur-kwic-test--with-results ("first X\nGAP X\nlast X\n" "X" nil region)
        (should (= (length occur-kwic--entries) 1))
        (with-current-buffer source
          (narrow-to-region (car restriction) (cdr restriction)))
        (revert-buffer nil t)
        (should-not (buffer-live-p result))
        (with-current-buffer source
          (should (= (point-min) (car restriction)))
          (should (= (point-max) (cdr restriction))))))))

(ert-deftest occur-kwic-test-region-keeps-source-line-numbers ()
  ;; Region boundaries must not renumber lines.  An existing source
  ;; narrowing still defines the numbering origin, as in ordinary Occur.
  (dolist (spec '((nil (9 . 24) 2 "prefix X suffix")
                  (nil (16 . 24) 2 "X suffix")
                  ((9 . 32) (16 . 24) 1 "X suffix")
                  ((9 . 32) (25 . 32) 2 "last X")))
    (let ((restriction (nth 0 spec)) (region (nth 1 spec)))
      (occur-kwic-test--with-results
          ("outside\nprefix X suffix\nlast X\n" "X"
           (when restriction
             (narrow-to-region (car restriction) (cdr restriction)))
           region)
        (should (= (length occur-kwic--entries) 1))
        (let ((entry (car occur-kwic--entries)))
          (should (= (occur-kwic--entry-line entry) (nth 2 spec)))
          (should (equal (occur-kwic--entry-text entry) (nth 3 spec))))))))

(ert-deftest occur-kwic-test-fields-do-not-limit-line-context ()
  ;; A field boundary is not a newline, even when a match crosses it.
  (dolist (regexp '("b" "cX" "X"))
    (occur-kwic-test--with-results
        ("abcXYZtail\n" regexp
         (progn (put-text-property 1 4 'field 'left)
                (put-text-property 4 (point-max) 'field 'right)))
      (should (= (length occur-kwic--entries) 1))
      (should (equal (occur-kwic--entry-text (car occur-kwic--entries)) "abcXYZtail"))
      (with-current-buffer source
        (should (eq (get-text-property 1 'field) 'left))
        (should (eq (get-text-property 4 'field) 'right)))))
  ;; Ignoring fields must still respect the actual search bounds.
  (occur-kwic-test--with-results
      ("prompt> value X tail\n" "X"
       (progn (put-text-property 1 9 'field 'prompt)
              (put-text-property 9 (point-max) 'field 'input))
       (cons 9 21))
    (should (equal (occur-kwic--entry-text (car occur-kwic--entries)) "value X tail"))))

(ert-deftest occur-kwic-test-refresh-and-saved-region ()
  (occur-kwic-test--with-results
      ("X\ninside X\nX\n" "X" nil (cons 3 11))
    (should (= (length occur-kwic--entries) 1))
    (should (eq (marker-buffer (car occur-kwic--region)) source))
    (occur-kwic-set-alignment 'right)
    (rename-buffer " *kwic-renamed*" t)
    (let ((name (buffer-name))
          (old-marker (caar (occur-kwic--entry-targets (car occur-kwic--entries)))))
      (with-current-buffer source
        (goto-char 1) (insert "before\n")
        (search-forward "inside ") (insert "X "))
      (revert-buffer nil t)
      (should (equal name (buffer-name)))
      (should (eq occur-kwic-alignment 'right))
      (should (= (length occur-kwic--entries) 2))
      (should-not (marker-buffer old-marker))
      (should (eq (marker-buffer (car occur-kwic--region)) source))
      (should-not (string-match-p "before" (occur-kwic--entry-text (car occur-kwic--entries)))))))

(ert-deftest occur-kwic-test-multiline-and-invalid-search-preserve-results ()
  (occur-kwic-test--with-results ("a X\nb Y\n" "X")
    (let ((text (buffer-string))
          (entries occur-kwic--entries))
      (dolist (regexp '("a X\nb" "[" ""))
        (with-current-buffer source (should-error (occur-kwic regexp)))
        (should (equal text (buffer-string)))
        (should (eq entries occur-kwic--entries)))
      ;; A regexp capable of matching newlines is accepted when its actual
      ;; matches do not contain one.
      (with-current-buffer source (occur-kwic "X\\|\nNEVER"))
      (should (= (length occur-kwic--entries) 1)))))

