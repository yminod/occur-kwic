               (condition-case err
                   (cl-letf (((symbol-function 'copy-marker)
                              (lambda (&rest args)
                                (let ((marker (apply copy-function args)))
                                  (push marker markers)
                                  (when (= (length markers) 2) (setq quit-flag t))
                                  marker))))
                     (occur-kwic--collect source "X" nil nil))
                 (quit (car err)))))
        (setq quit-flag nil))
      (should (= (length markers) 2))
      (dolist (marker markers) (should-not (marker-buffer marker))))))

(ert-deftest occur-kwic-test-population-abort-discards-incomplete-results ()
  (dolist (condition '(error quit))
    (dolist (refresh '(nil t))
      (occur-kwic-test--with-results ("abcXdefXghiX\n" "X" nil '(2 . 13))
        (let* ((survivor (clone-buffer " *kwic-abort-survivor*" nil))
               (target (if refresh result (generate-new-buffer " *kwic-aborted-result*")))
               (line "abcXdefXghiX")
               (collect-function (symbol-function 'occur-kwic--collect))
               (insert-function (symbol-function 'insert))
               (old-entries occur-kwic--entries)
               (rows 0) collected)
          (should
           (eq condition
               (condition-case err
                   (cl-letf (((symbol-function 'occur-kwic--collect)
                              (lambda (&rest args)
                                (setq collected (apply collect-function args))))
                             ((symbol-function 'insert)
                              (lambda (&rest args)
                                (when (and (eq (current-buffer) target)
                                           (equal args (list line))
                                           (= (cl-incf rows) 3))
                                  (signal condition nil))
                                (apply insert-function args))))
                     (occur-kwic--run source "." nil nil 'left target))
                 ((error quit) (car err)))))
          (should (= rows 3))
          (should-not (buffer-live-p target))
          (dolist (entry collected)
            (dolist (pair (occur-kwic--entry-targets entry))
              (should-not (marker-buffer (car pair)))
              (should-not (marker-buffer (cdr pair)))))
          (dolist (entry old-entries)
            (should (eq (marker-buffer (caar (occur-kwic--entry-targets entry)))
                        (unless refresh source))))
          (with-current-buffer survivor
            (should (= (length occur-kwic--entries) 3))
            (should (eq (marker-buffer (car occur-kwic--region)) source))
            (occur-kwic--refresh-windows)
            (goto-char (occur-kwic--entry-row-begin (car occur-kwic--entries)))
            (occur-mode-goto-occurrence)
            (should (eq (current-buffer) source)))
          (with-current-buffer source
            (should (equal (buffer-string) "abcXdefXghiX\n"))
            (should-not (buffer-modified-p))))))))

(ert-deftest occur-kwic-test-interrupted-overlay-is-owned-and-redrawn ()
  (dolist (condition '(error quit))
    (occur-kwic-test--with-results
        ((concat (make-string 100 ?a) "XXX" (make-string 100 ?b) "\n") "XXX")
      (let ((view (car occur-kwic--views))
            (make-function (symbol-function 'make-overlay))
            (put-function (symbol-function 'overlay-put))
            created)
        (should
         (eq condition
             (condition-case err
                 (cl-letf (((symbol-function 'make-overlay)
                            (lambda (&rest args)
                              (let ((overlay (apply make-function args)))
                                (push overlay created)
                                overlay)))
                           ((symbol-function 'overlay-put)
                            (lambda (overlay property value)
                              (when (eq property 'occur-kwic) (signal condition nil))
                              (funcall put-function overlay property value))))
                   (occur-kwic--draw-view view))
               ((error quit) (car err)))))
        (should created)
        (should-not (occur-kwic--view-width view))
        (dolist (overlay created)
          (should (memq overlay (occur-kwic--view-overlays view))))
        (occur-kwic--refresh-windows)
        (dolist (overlay created) (should-not (overlay-buffer overlay)))
        (should (= (occur-kwic--view-width view) (window-body-width)))
        (should (= (cadr (occur-kwic-test--visible (car occur-kwic--entries) (selected-window)))
                   (/ (window-body-width) 2)))))))

(ert-deftest occur-kwic-test-clone-abort-keeps-original-resources ()
  (dolist (condition '(error quit))
    (occur-kwic-test--with-results ("abcXdefXghiX\n" "X" nil '(2 . 13))
      (goto-char (occur-kwic--entry-row-begin (car occur-kwic--entries)))
      (occur--set-arrow)
      (occur-kwic-toggle-line)
      (let ((copy-function (symbol-function 'copy-marker))
            (entry-function (symbol-function 'copy-occur-kwic--entry))
            (entries occur-kwic--entries)
            (region occur-kwic--region)
            (arrow overlay-arrow-position)
            (expanded occur-kwic--expanded)
            (views occur-kwic--views)
            (copies 0) markers)
        (should
         (eq condition
             (condition-case err
                 (cl-letf (((symbol-function 'copy-marker)
                            (lambda (&rest args)
                              (let ((marker (apply copy-function args)))
                                (when (eq (marker-buffer marker) source) (push marker markers))
                                marker)))
                           ((symbol-function 'copy-occur-kwic--entry)
                            (lambda (entry)
                              (when (= (cl-incf copies) 3) (signal condition nil))
                              (funcall entry-function entry))))
                   (clone-buffer " *kwic-aborted-clone*" nil))
               ((error quit) (car err)))))
        (should (= copies 3))
        (should-not (get-buffer " *kwic-aborted-clone*"))
        (should (= (length markers) 6))
        (dolist (marker markers) (should-not (marker-buffer marker)))
        (with-current-buffer result
          (should (eq entries occur-kwic--entries))
          (should (eq views occur-kwic--views))
          (should (eq region occur-kwic--region))
          (should (eq (marker-buffer (car region)) source))
          (should (eq (marker-buffer arrow) result))
          (should (eq expanded occur-kwic--expanded))
          (dolist (entry entries)
            (should (eq (marker-buffer (caar (occur-kwic--entry-targets entry))) source)))
          (occur-kwic-set-alignment 'left)
          (occur-kwic--refresh-windows))))))

(ert-deftest occur-kwic-test-cleanup-releases-all-owned-resources ()
  (occur-kwic-test--with-results
      ((concat (make-string 100 ?a) "XXX" (make-string 100 ?b) "\n") "XXX" nil '(2 . 204))
    (goto-char (occur-kwic--entry-row-begin (car occur-kwic--entries)))
    (occur--set-arrow)
