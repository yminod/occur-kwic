(defmacro occur-kwic-test--with-results (spec &rest body)
  "Search SPEC (TEXT REGEXP &optional SETUP REGION), then run BODY in results."
  (declare (indent 1))
  `(let ((initial-buffers (buffer-list))
         (source (generate-new-buffer " *kwic-source*"))
         (occur-kwic-alignment 'left)
         (next-error-last-buffer nil)
         (next-error-highlight nil)
         (occur-hook nil)
         result)
     (unwind-protect
         (save-window-excursion
           (with-current-buffer source
             (insert ,(nth 0 spec))
             (goto-char (point-min))
             (setq-local case-fold-search nil)
             (set-buffer-modified-p nil)
             ,(nth 2 spec)
             (setq result (occur-kwic ,(nth 1 spec) ,(nth 3 spec))))
           (when result (select-window (get-buffer-window result t)))
           ,@body)
       (dolist (buffer (buffer-list))
         (unless (memq buffer initial-buffers) (kill-buffer buffer))))))

(defun occur-kwic-test--visible (entry window)
  "Read displayed row text and match column from actual WINDOW properties.
Return (TEXT MATCH-COLUMN), without consulting the layout calculation."
  (let ((position (occur-kwic--entry-row-begin entry))
        (end (occur-kwic--entry-row-end entry))
        (match (+ (occur-kwic--entry-text-begin entry) (occur-kwic--entry-begin entry)))
        (text "") match-column)
    (while (< position (1+ end))
      (unless (get-char-property position 'invisible window)
        (when (= position match) (setq match-column (string-width text)))
        (let ((before (get-char-property position 'before-string window))
              (display (get-char-property position 'display window)))
          (when before (setq text (concat text before)))
          (unless (= position end)
            (setq text (concat text (if (stringp display) display
                                     (char-to-string (char-after position))))))))
      (setq position (1+ position)))
    (list text match-column)))

(ert-deftest occur-kwic-test-full-lines-and-source-state ()
  (occur-kwic-test--with-results
      ("long context X with a long suffix\nX\n" "X" (goto-char 4))
    (should (derived-mode-p 'occur-mode))
    (should buffer-read-only)
    (should truncate-lines)
    (should-not (buffer-modified-p))
    (should (= (length occur-kwic--entries) 2))
    (should (string-match-p "long context X with a long suffix" (buffer-string)))
    (with-current-buffer source
      (should (= (point) 4))
      (should-not (buffer-modified-p))
      (should (equal (buffer-string) "long context X with a long suffix\nX\n")))))

(ert-deftest occur-kwic-test-columns-honor-display-settings-and-byte-characters ()
  (with-temp-buffer
    (let ((buffer-display-table nil)
          (standard-display-table nil)
          (ctl-arrow t))
      (should (equal (occur-kwic--columns "a\t界e\u0301\uFE0F\u200D" 4)
                     [0 1 4 6 7 7 7 7]))
      (should (equal (occur-kwic--columns (unibyte-string 128 255 ?X) 4)
                     [0 4 5 6]))
      (should (equal (occur-kwic--columns (string 1 ?X) 4) [0 2 3]))
      (let ((ctl-arrow nil))
        (should (equal (occur-kwic--columns (string 1 ?X) 4) [0 4 5])))
      (let ((buffer-display-table (make-display-table)))
        (aset buffer-display-table ?a [?界 ?x])
        (aset buffer-display-table 1 [?x ?y ?z])
        (aset buffer-display-table 128 [?y ?z])
        (should (equal (occur-kwic--columns (string ?a ?\t 1 128 ?e #x301) 4)
                       [0 3 4 7 9 10 10]))
        (should (equal (occur-kwic--columns (unibyte-string 128 ?a) 4) [0 2 5])))
      (let ((char-width-table (copy-sequence char-width-table)))
        (set-char-table-range char-width-table ?界 3)
        (should (equal (occur-kwic--columns "界\tX" 4) [0 3 4 5]))))))

(ert-deftest occur-kwic-test-reuses-line-data-within-each-search ()
  (let ((columns-function (symbol-function 'occur-kwic--columns))
        (column-calls 0)
        (line (apply #'concat (make-list 100 "aX"))))
    (cl-letf (((symbol-function 'occur-kwic--columns)
               (lambda (text tab-size)
                 (setq column-calls (1+ column-calls))
                 (funcall columns-function text tab-size))))
      (occur-kwic-test--with-results ((concat line "\n" line "\ntail X\n") "X")
        (should (= (length occur-kwic--entries) 201))
        (should (= column-calls 3))
        (let* ((first (car occur-kwic--entries))
               (last-on-line (nth 99 occur-kwic--entries))
               (next-line (nth 100 occur-kwic--entries))
               (old-text (occur-kwic--entry-text first))
               (old-columns (occur-kwic--entry-columns first))
               (snapshot (buffer-substring-no-properties (point-min) (point-max))))
          (should (eq old-text (occur-kwic--entry-text last-on-line)))
          (should (eq old-columns (occur-kwic--entry-columns last-on-line)))
          ;; Identical text on another physical line has its own line data.
          (should-not (eq old-columns (occur-kwic--entry-columns next-line)))
          (cl-mapc (lambda (entry position)
                     (should (= (marker-position (caar (occur-kwic--entry-targets entry)))
                                position)))
                   (list first last-on-line next-line) '(2 200 203))
          (occur-kwic-set-alignment 'right)
          (should (= column-calls 3))
          (with-current-buffer source (goto-char (point-min)) (insert "z"))
          (should (equal snapshot (buffer-substring-no-properties (point-min) (point-max))))
          (revert-buffer nil t)
          (should (= column-calls 6))
          (should (equal (occur-kwic--entry-text (car occur-kwic--entries))
                         (concat "z" line)))
          (should-not (eq old-columns (occur-kwic--entry-columns (car occur-kwic--entries))))
          (should (equal old-text line)))))))

(ert-deftest occur-kwic-test-shared-line-data-keeps-tabs-and-combining-context ()
  (occur-kwic-test--with-results
      ("あ\tX é X 尾\n" "X" (setq-local tab-width 4))
    (let ((first (car occur-kwic--entries))
          (second (cadr occur-kwic--entries))
          (window (selected-window)))
      (should (= (length occur-kwic--entries) 2))
      (should (eq (occur-kwic--entry-columns first) (occur-kwic--entry-columns second)))
      (should (= (marker-position (caar (occur-kwic--entry-targets first))) 3))
      (should (= (marker-position (caar (occur-kwic--entry-targets second))) 8))
      (dolist (alignment '(left center right))
        (occur-kwic-set-alignment alignment)
        (dolist (entry occur-kwic--entries)
          (should (= (+ (cadr (occur-kwic-test--visible entry window))
                        (if (eq alignment 'right) 1 0))
                     (/ (window-body-width window) 2)))
          (should (equal (occur-kwic--entry-text entry) "あ\tX é X 尾")))))))

(ert-deftest occur-kwic-test-alignment-including-japanese ()
  (occur-kwic-test--with-results
      ("short X tail\nlonger YY suffix\nあいうえ ZZZ かきくけ\n" "X\\|YY\\|ZZZ")
    (let* ((window (selected-window)) (anchor (/ (window-body-width window) 2)))
      (dolist (alignment '(left center right))
        (occur-kwic-set-alignment alignment)
        (cl-mapc
         (lambda (entry width)
           (let ((column (cadr (occur-kwic-test--visible entry window))))
             (should (= (+ column (pcase alignment
                                    ('left 0) ('center (/ width 2)) ('right width)))
                        anchor))))
         occur-kwic--entries '(1 2 3))))))

(ert-deftest occur-kwic-test-reselect-alignment-resets-all-window-scrolls ()
  (occur-kwic-test--with-results
      ((concat (make-string 100 ?a) "XXX" (make-string 100 ?b) "\n") "XXX")
    (delete-other-windows)
    (let* ((first (selected-window))
           (second (split-window-right 30))
           (text (buffer-string))
           (position (point)))
      (set-window-buffer second result)
      (occur-kwic-set-alignment 'right)
      (set-window-hscroll first 7)
      (set-window-hscroll second 11)
      ;; The alignment cache already contains `right' in both windows.
      (occur-kwic-set-alignment 'right)
      (dolist (window (list first second))
        (should (zerop (window-hscroll window))))
      (should (= (point) position))
      (should (equal text (buffer-string)))
      (should-not (buffer-modified-p)))))

(ert-deftest occur-kwic-test-alignment-restores-kwic-after-full-line-view ()
  (occur-kwic-test--with-results
      ((concat (make-string 100 ?a) "XXX tail\nprefix XXX suffix\n") "XXX")
    (let ((entry (car occur-kwic--entries))
          (window (selected-window))
          (text (buffer-string)))
      (dolist (reveal '(toggle isearch))
        (dolist (alignment '(left center right))
          (goto-char (occur-kwic--entry-row-begin entry))
          (pcase reveal
            ('toggle (occur-kwic-toggle-line))
            ('isearch
             (run-hooks 'isearch-mode-hook)
             (run-hooks 'isearch-mode-end-hook)))
          (should (eq occur-kwic--expanded entry))
          (set-window-hscroll window 30)
          (occur-kwic-set-alignment alignment)
          (should-not occur-kwic--expanded)
          (should-not auto-hscroll-mode)
          (should (zerop (window-hscroll window)))
          (dolist (row occur-kwic--entries)
            (should (= (+ (cadr (occur-kwic-test--visible row window))
                          (pcase alignment ('left 0) ('center 1) ('right 3)))
                       (/ (window-body-width window) 2))))))
      (should (equal text (buffer-string)))
      (should-not (buffer-modified-p)))))

